        "clientRole": false
      },
      {
        "name": "manager",
        "description": "Resource manager role",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "customer",
        "description": "Customer role for bookings",
        "composite": false,
        "clientRole": false
      }
    ]
  },

  "defaultRole": {
    "name": "default-roles-ajasta",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false
  },

